+static void client_disconnect(struct client *this);
+
+/* Sends the whole message including its NUL terminator. A message cut short
+ * leaves the peer mid-message, so the connection is dropped if the rest can't
+ * be sent. */
+static int
+send_message(struct client *this, const char *buf, size_t len, int flags)
+{
+	struct impl *impl = this->impl;
+	size_t pos = 0;
+	ssize_t res;
+
+	while (pos < len) {
+		res = send(this->fd, &buf[pos], len - pos, MSG_NOSIGNAL | flags);
+		if (res > 0) {
+			pos += res;
+			continue;
+		}
+		if (res < 0 && errno == EINTR)
+			continue;
+
+		res = res < 0 ? -errno : -EIO;
+		if (res == -EWOULDBLOCK)
+			res = -EAGAIN;
+
+		if (pos > 0) {
+			spa_log_error(impl->log, "Message only partly sent (%s), disconnecting",
+					spa_strerror(res));
+			client_disconnect(this);
+		} else if (res == -EAGAIN) {
+			spa_log_warn(impl->log, "Service is not keeping up, dropping message");
+		} else {
+			spa_log_error(impl->log, "Error writing message: %s",
+					spa_strerror(res));
+		}
+		return res;
+	}
+
+	return 0;
+}
