+/* Connects to the service and follows the volume and mute changes it pushes.
+ * If the service is unreachable, or goes away later, this keeps retrying on
+ * loop_utils' loop. */
 int spa_acp_ext_volume_init(struct spa_acp_ext_volume *ext_volume, struct spa_varlink *varlink,
