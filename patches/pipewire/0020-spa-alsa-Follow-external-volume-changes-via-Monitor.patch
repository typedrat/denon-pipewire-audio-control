@@ -39,6 +73,11 @@ static struct spa_varlink_client_events client_events = {
 	.destroy = client_destroy,
 };
 
+static struct spa_varlink_client_events monitor_events = {
+	.disconnect = monitor_disconnect,
+	.destroy = client_destroy,
+};
+
 /* Points params at the reply's "parameters" object and returns its length,
  * or a negative errno for an error reply. */
 static int reply_parameters(const char *reply, int len, const char **params)
@@ -119,9 +158,68 @@ static int parse_mute(const char *params, int len, bool *mute)
 	return -ENOENT;
 }
 
-int
-spa_acp_ext_volume_init(struct spa_acp_ext_volume *ext_volume, struct spa_varlink *varlink,
-		const char *path, const char *device, const char *route)
+static void monitor_reply(void *data, const char *params, const char *error,
+		size_t len, bool continues)
+{
+	struct spa_acp_ext_volume *ext_volume = data;
+	struct spa_json it;
+	char key[64], route[256] = "";
+	const char *val;
+	pa_cvolume volume;
+	bool mute;
+	int l;
+
+	if (error) {
+		pa_log_error("External volume monitor failed: %.*s", (int)len, error);
+		ext_volume->monitoring = false;
+		schedule_reconnect(ext_volume);
+		/* Back off from a service that keeps refusing Monitor */
+		ext_volume->reconnect_msec = SPA_MIN(ext_volume->reconnect_msec * 2,
+				(uint32_t)RECONNECT_MAX_MSEC);
+		return;
+	}
+
+	ext_volume->reconnect_msec = RECONNECT_MSEC;
+
+	if (!continues) {
+		pa_log_warn("External volume monitor ended");
+		ext_volume->monitoring = false;
+		schedule_reconnect(ext_volume);
+	}
+
+	if (!params || !ext_volume->changed)
+		return;
+
+	if (spa_json_begin_object(&it, params, len) > 0) {
+		while ((l = spa_json_object_next(&it, key, sizeof(key), &val)) > 0) {
+			if (spa_streq(key, "route"))
+				spa_json_parse_stringn(val, l, route, sizeof(route));
+		}
+	}
+
+	ext_volume->changed(ext_volume->data, route,
+			parse_volume(params, len, &volume) == 0 ? &volume : NULL,
+			parse_mute(params, len, &mute) == 0 ? &mute : NULL);
+}
+
+static void close_clients(struct spa_acp_ext_volume *ext_volume)
+{
+	if (ext_volume->monitor_client) {
+		spa_hook_remove(&ext_volume->monitor_listener);
+		spa_varlink_client_destroy(ext_volume->monitor_client);
+		ext_volume->monitor_client = NULL;
+	}
+	if (ext_volume->client) {
+		spa_hook_remove(&ext_volume->listener);
+		spa_varlink_client_destroy(ext_volume->client);
+		ext_volume->client = NULL;
+	}
+	ext_volume->connected = false;
+	ext_volume->monitoring = false;
+}
+
+static int get_capabilities(struct spa_acp_ext_volume *ext_volume,
+		struct spa_varlink_client *client)
 {
 	struct spa_json_builder params_json;
 	struct spa_json reply_json;
@@ -132,27 +230,16 @@ spa_acp_ext_volume_init(struct spa_acp_ext_volume *ext_volume, struct spa_varlin
 	size_t len;
 	int res;
 
-	pa_log_info("Connecting to external volume control at '%s'", path);
-
-	ext_volume->client = spa_varlink_connect(varlink, path);
-
-	if (!ext_volume->client) {
-		pa_log_error("Could not connect to volume control service at: %s", path);
-		return -EINVAL;
-	}
-
-	spa_varlink_client_add_listener(ext_volume->client, &ext_volume->listener, &client_events, ext_volume);
-
 	spa_json_builder_memstream(&params_json, &params, &len, 0);
 
 	spa_json_builder_object_push(&params_json, NULL, "{");
-	spa_json_builder_object_string(&params_json, "device", device ? device : "");
+	spa_json_builder_object_string(&params_json, "device", ext_volume->device);
 	spa_json_builder_pop(&params_json, "}");
 
 	spa_json_builder_close(&params_json);
 
 	/* Initial probe for capabilities might take a bit longer than the default timeout */
-	res = spa_varlink_client_call_sync(ext_volume->client, METHOD_GET_CAPABILITIES, params, &reply, 2000);
+	res = spa_varlink_client_call_sync(client, METHOD_GET_CAPABILITIES, params, &reply, 2000);
 
 	if (res < 0) {
 		pa_log_error("Failed to query volume control capabilities: %s", spa_strerror(res));
@@ -207,13 +294,169 @@ done:
 	return res;
 }
 
-void
-spa_acp_ext_volume_destroy(struct spa_acp_ext_volume *ext_volume)
+static bool wants_monitor(struct spa_acp_ext_volume *ext_volume)
+{
+	return ext_volume->changed && (ext_volume->flags &
+			(SPA_AUDIO_VOLUME_CONTROL_READ_VOLUME | SPA_AUDIO_VOLUME_CONTROL_READ_MUTE));
+}
+
+/* Replaces the main connection, querying capabilities first if they aren't
+ * known yet. The old client stays in place until the new one works: calls
+ * on it fail rather than falling back to the card's own mixer. */
+static int connect_client(struct spa_acp_ext_volume *ext_volume)
 {
+	struct spa_varlink_client *client;
+	int res;
+
+	client = spa_varlink_connect(ext_volume->varlink, ext_volume->path);
+	if (!client)
+		return -ECONNREFUSED;
+
+	if (ext_volume->flags == 0 && (res = get_capabilities(ext_volume, client)) < 0) {
+		spa_varlink_client_destroy(client);
+		return res;
+	}
+
 	if (ext_volume->client) {
+		spa_hook_remove(&ext_volume->listener);
 		spa_varlink_client_destroy(ext_volume->client);
-		ext_volume->client = NULL;
 	}
+	ext_volume->client = client;
+	ext_volume->connected = true;
+	spa_varlink_client_add_listener(client, &ext_volume->listener,
+			&client_events, ext_volume);
+
+	return 0;
+}
+
+/* Monitor gets its own connection: a pending "more" call blocks the sync
+ * reads ACP makes on the main one. */
+static int start_monitor(struct spa_acp_ext_volume *ext_volume)
+{
+	struct spa_json_builder params_json;
+	struct spa_varlink_client *client;
+	spa_autofree char *params = NULL;
+	size_t len;
+	int res;
+
+	client = spa_varlink_connect(ext_volume->varlink, ext_volume->path);
+	if (!client)
+		return -ECONNREFUSED;
+
+	spa_json_builder_memstream(&params_json, &params, &len, 0);
+	spa_json_builder_object_push(&params_json, NULL, "{");
+	spa_json_builder_object_string(&params_json, "device", ext_volume->device);
+	spa_json_builder_pop(&params_json, "}");
+	spa_json_builder_close(&params_json);
+
+	res = spa_varlink_client_call(client, METHOD_MONITOR, params,
+			false, true, monitor_reply, ext_volume);
+	if (res < 0) {
+		spa_varlink_client_destroy(client);
+		return res;
+	}
+
+	if (ext_volume->monitor_client) {
+		spa_hook_remove(&ext_volume->monitor_listener);
+		spa_varlink_client_destroy(ext_volume->monitor_client);
+	}
+	ext_volume->monitor_client = client;
+	ext_volume->monitoring = true;
+	spa_varlink_client_add_listener(client, &ext_volume->monitor_listener,
+			&monitor_events, ext_volume);
+
+	return 0;
+}
+
+static void on_reconnect_timer(void *data, uint64_t expirations)
+{
+	struct spa_acp_ext_volume *ext_volume = data;
+	bool had_flags = ext_volume->flags != 0;
+	int res;
+
+	if (!ext_volume->connected) {
+		if ((res = connect_client(ext_volume)) < 0) {
+			pa_log_debug("Could not reconnect to %s: %s", ext_volume->path,
+					spa_strerror(res));
+			schedule_reconnect(ext_volume);
+			return;
+		}
+		pa_log_info("Connected to external volume control at %s", ext_volume->path);
+
+		if (!had_flags && ext_volume->flags && ext_volume->ready)
+			ext_volume->ready(ext_volume->data);
+	}
+
+	if (wants_monitor(ext_volume) && !ext_volume->monitoring) {
+		if ((res = start_monitor(ext_volume)) < 0) {
+			pa_log_debug("Could not restart monitor at %s: %s", ext_volume->path,
+					spa_strerror(res));
+			schedule_reconnect(ext_volume);
+		}
+	}
+}
+
+int
+spa_acp_ext_volume_init(struct spa_acp_ext_volume *ext_volume, struct spa_varlink *varlink,
+		struct spa_loop_utils *loop_utils, const char *path, const char *device,
+		const char *route, spa_acp_ext_volume_changed_t changed,
+		spa_acp_ext_volume_ready_t ready, void *data)
+{
+	int res;
+
+	pa_log_info("Connecting to external volume control at '%s'", path);
+
+	ext_volume->varlink = varlink;
+	ext_volume->loop_utils = loop_utils;
+	ext_volume->path = strdup(path);
+	ext_volume->device = strdup(device ? device : "");
+	ext_volume->changed = changed;
+	ext_volume->ready = ready;
+	ext_volume->data = data;
+	ext_volume->reconnect_msec = RECONNECT_MSEC;
+
+	if (loop_utils)
+		ext_volume->reconnect_timer = spa_loop_utils_add_timer(loop_utils,
+				on_reconnect_timer, ext_volume);
+	if (!ext_volume->reconnect_timer)
+		pa_log_warn("No loop utils; external volume control won't reconnect");
+
+	if ((res = connect_client(ext_volume)) < 0) {
+		if (!ext_volume->reconnect_timer) {
+			pa_log_error("Could not connect to volume control service at %s: %s",
+					path, spa_strerror(res));
+			return res;
+		}
+		pa_log_warn("Could not connect to volume control service at %s: %s; retrying",
+				path, spa_strerror(res));
+		schedule_reconnect(ext_volume);
+		return 0;
+	}
+
+	if (wants_monitor(ext_volume) && (res = start_monitor(ext_volume)) < 0) {
+		pa_log_error("Could not monitor external volume: %s", spa_strerror(res));
+		schedule_reconnect(ext_volume);
+	}
+
+	return 0;
+}
+
+void
+spa_acp_ext_volume_destroy(struct spa_acp_ext_volume *ext_volume)
+{
+	if (ext_volume->reconnect_timer) {
+		spa_loop_utils_destroy_source(ext_volume->loop_utils, ext_volume->reconnect_timer);
+		ext_volume->reconnect_timer = NULL;
+	}
+	close_clients(ext_volume);
+	free(ext_volume->path);
+	ext_volume->path = NULL;
+	free(ext_volume->device);
+	ext_volume->device = NULL;
+	ext_volume->flags = 0;
+	ext_volume->changed = NULL;
+	ext_volume->ready = NULL;
+	ext_volume->data = NULL;
 }
 
