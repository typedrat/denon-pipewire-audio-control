+	res = spa_acp_ext_volume_init(&card->ext_volume, acp_varlink, acp_loop_utils,
+			impl->ext_volume_path, impl->name, NULL,
+			ext_volume_changed, ext_volume_ready, impl);
 	if (res < 0)
 		spa_acp_ext_volume_destroy(&card->ext_volume);
