+/* Applies a volume reported by the external service, expanding a single value
+ * to every channel. */
+static void update_ext_volume(pa_alsa_device *dev, const pa_cvolume *ext_vol)
+{
+	pa_card *impl = dev->card;
+	pa_cvolume r;
+	uint32_t i;
+
+	if (ext_vol->channels == 1) {
+		r.channels = dev->device.format.channels;
+		for (i = 0; i < r.channels; i++)
+			r.values[i] = ext_vol->values[0];
+	} else if (ext_vol->channels == dev->device.format.channels) {
+		r = *ext_vol;
+	} else {
+		pa_log_error("Mismatch channel count: device %u != volume %u",
+				dev->device.format.channels, ext_vol->channels);
+		return;
+	}
+
+	if (pa_cvolume_equal(&dev->hardware_volume, &r))
+		return;
+
+	dev->real_volume = dev->hardware_volume = r;
+	pa_cvolume_reset(&dev->soft_volume, r.channels);
+	pa_log_info("New external volume: %d", pa_cvolume_max(&r));
+
+	if (impl->events && impl->events->volume_changed)
+		impl->events->volume_changed(impl->user_data, &dev->device);
+}
+
+static void update_ext_mute(pa_alsa_device *dev, bool mute)
+{
+	pa_card *impl = dev->card;
+
+	if (mute == dev->muted)
+		return;
+
+	dev->muted = mute;
+	pa_log_info("New external mute: %d", mute);
+
+	if (impl->events && impl->events->mute_changed)
+		impl->events->mute_changed(impl->user_data, &dev->device);
+}
+
+static void ext_volume_changed(void *data, const char *route,
+		const pa_cvolume *volume, const bool *mute)
+{
+	pa_card *impl = data;
+	pa_alsa_device *dev;
+	uint32_t idx;
+
+	PA_DYNARRAY_FOREACH(dev, &impl->out.devices, idx) {
+		if (!(dev->device.flags & ACP_DEVICE_ACTIVE) ||
+				!dev->active_port || !spa_streq(dev->active_port->name, route))
+			continue;
+		if (volume)
+			update_ext_volume(dev, volume);
+		if (mute)
+			update_ext_mute(dev, *mute);
+	}
+}
+
+static void mixer_volume_init(pa_card *impl, pa_alsa_device *dev);
+
+static void ext_volume_ready_device(pa_card *impl, pa_alsa_device *dev)
+{
+	/* Devices whose mixer setup picked external volume are flagged
+	 * HW_VOLUME even before the capabilities are known. */
+	if (!(dev->device.flags & ACP_DEVICE_ACTIVE) ||
+			!(dev->device.flags & ACP_DEVICE_HW_VOLUME) || !dev->active_port)
+		return;
+
+	dev->device.ext_volume_flags = impl->card.ext_volume.flags;
+	mixer_volume_init(impl, dev);
+
+	/* Drop software attenuation applied while volume was unmanaged */
+	pa_cvolume_reset(&dev->soft_volume, dev->device.format.channels);
+
+	if (dev->read_volume)
+		dev->read_volume(dev);
+	if (dev->read_mute)
+		dev->read_mute(dev);
+
+	/* Republishes the route, which carries ext_volume_flags */
+	if (impl->events && impl->events->volume_changed)
+		impl->events->volume_changed(impl->user_data, &dev->device);
+}
+
+/* The service was unreachable when the devices were set up, so they got no
+ * external volume hooks; install them now that its capabilities are known. */
+static void ext_volume_ready(void *data)
+{
+	pa_card *impl = data;
+	pa_alsa_device *dev;
+	uint32_t idx;
+
+	/* out.devices holds capture devices too */
+	PA_DYNARRAY_FOREACH(dev, &impl->out.devices, idx)
+		ext_volume_ready_device(impl, dev);
+}
+
