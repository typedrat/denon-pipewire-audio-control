 #define METHOD_READ_MUTE VOLUME_CONTROL_BASE "ReadMute"
 #define METHOD_WRITE_MUTE_VALUE VOLUME_CONTROL_BASE "WriteMuteValue"
 #define METHOD_WRITE_MUTE_TOGGLE VOLUME_CONTROL_BASE "WriteMuteToggle"
+#define METHOD_MONITOR VOLUME_CONTROL_BASE "Monitor"
 
 #define DEFAULT_TIMEOUT_MSEC 500
+#define RECONNECT_MSEC 1000
+#define RECONNECT_MAX_MSEC 30000
+
+/* The main connection and Monitor back off separately, so a Monitor that
+ * keeps failing doesn't hold up reconnecting the main connection. Both share
+ * one timer, armed with the shortest delay requested since it last fired. */
+static void schedule_reconnect(struct spa_acp_ext_volume *ext_volume, uint32_t msec)
+{
+	struct timespec value = {
+		.tv_sec = msec / 1000,
+		.tv_nsec = (msec % 1000) * SPA_NSEC_PER_MSEC,
+	};
+
+	if (!ext_volume->loop_utils || !ext_volume->reconnect_timer)
+		return;
+	if (ext_volume->pending_msec && ext_volume->pending_msec <= msec)
+		return;
+
+	ext_volume->pending_msec = msec;
+	spa_loop_utils_update_timer(ext_volume->loop_utils,
+			ext_volume->reconnect_timer, &value, NULL, false);
+}
 
+static uint32_t backoff(uint32_t msec)
+{
+	return SPA_MIN(msec * 2, (uint32_t)RECONNECT_MAX_MSEC);
+}
+
+/* Clients can't be torn down from inside their own callbacks, so
+ * reconnecting happens on a timer. */
 static void client_disconnect(void *userdata)
 {
-	/* TODO: reconnect? bail? */
+	struct spa_acp_ext_volume *ext_volume = userdata;
+
+	if (!ext_volume->unreachable)
+		pa_log_warn("Lost connection to external volume control at %s",
+				ext_volume->path);
+	ext_volume->unreachable = true;
+	ext_volume->connected = false;
+	schedule_reconnect(ext_volume, ext_volume->connect_msec);
+}
+
+static void monitor_disconnect(void *userdata)
+{
+	struct spa_acp_ext_volume *ext_volume = userdata;
+
+	/* The main connection reports the service going away */
+	pa_log_debug("Lost external volume monitor at %s", ext_volume->path);
+	ext_volume->monitoring = false;
+	schedule_reconnect(ext_volume, ext_volume->monitor_msec);
 }
 
 static void client_destroy(void *userdata)
@@ -39,6 +90,11 @@ static struct spa_varlink_client_events client_events = {
 	.destroy = client_destroy,
 };
 
+static struct spa_varlink_client_events monitor_events = {
+	.disconnect = monitor_disconnect,
+	.destroy = client_destroy,
+};
+
 /* Points params at the reply's "parameters" object and returns its length,
  * or a negative errno for an error reply. */
 static int reply_parameters(const char *reply, int len, const char **params)
@@ -119,9 +175,67 @@ static int parse_mute(const char *params, int len, bool *mute)
 	return -ENOENT;
 }
 
