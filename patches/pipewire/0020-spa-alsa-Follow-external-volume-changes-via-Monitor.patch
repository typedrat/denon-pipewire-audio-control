 	} else if (dev->mixer_handle) {
 		/* ALSA mixer for volume */
 		if (dev->mixer_path->has_volume_mute && dev->muted) {
@@ -1469,9 +1560,10 @@ static void set_volume(pa_alsa_device *dev, const pa_cvolume *v)
 				return;
 			}
 
-			/* Update volume if we were successful */
